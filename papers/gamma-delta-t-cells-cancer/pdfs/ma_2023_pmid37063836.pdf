      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Owing to their antitumor and major histocompatibility complex (MHC)-independent capacities, &amp;gamma;&amp;delta; T cells have gained popularity in adoptive T-cell immunotherapy in recent years</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
