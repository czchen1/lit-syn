         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A Bibliometric and Knowledge-Map Analysis of CAR-T Cells From 2009 to 2021</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Lele Miao; Juan Zhang; Zhengchao Zhang; Song Wang; Futian Tang; Muzhou Teng; Yumin Li</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Objectives: A bibliometric and knowledge-map analysis is used to explore hotspots&amp;rsquo; evolution and development trends in the CAR-T cell field</rdf:li>
            </rdf:Alt>
         </dc:description>
      </rdf:Description>
